# .gitignore

# ignore go build files
*.go.o
*.go.p
*.go.s

# ignore go test files
*_test.go
*_testmain.go

# ignore go vet files
*_test.go
*_testmain.go

# ignore vendor directory
vendor/

# ignore node_modules directory
node_modules/

# ignore coverage directory
coverage/

# ignore log files
*.log

# ignore docker files
Dockerfile
docker-compose.yml